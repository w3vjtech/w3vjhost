#!/bin/bash
# info: change web domain application template
# options: USER DOMAIN TEMPLATE [ENTRY]
#
# example: v-change-web-domain-app-tpl admin example.com NODE-24
# example: v-change-web-domain-app-tpl admin example.com PY-3_13 wsgi:app
#
# This function changes the runtime version (or runtime) of a web domain
# application. ENTRY is required when switching between Node.js and Python.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1
domain=$2
app_template=$3
app_entry=$4

# Includes
# shellcheck source=/etc/hestiacp/hestia.conf
source /etc/hestiacp/hestia.conf
# shellcheck source=/usr/local/hestia/func/main.sh
source $HESTIA/func/main.sh
# shellcheck source=/usr/local/hestia/func/runtime.sh
source $HESTIA/func/runtime.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

# Additional argument formatting
format_domain
format_domain_idn

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '3' "$#" 'USER DOMAIN TEMPLATE [ENTRY]'
is_format_valid 'user' 'domain' 'app_template' 'app_entry'
is_object_valid 'user' 'USER' "$user"
is_object_unsuspended 'user' 'USER' "$user"
is_object_valid 'web' 'DOMAIN' "$domain"
is_object_unsuspended 'web' 'DOMAIN' "$domain"
old_template=$(get_web_app_value 'APP_TEMPLATE')
if [ -z "$old_template" ]; then
	check_result "$E_NOTEXIST" "$domain doesn't run an application"
fi
prepare_app_template "$old_template"
old_runtime="$app_runtime"
is_app_template_valid "$app_template"
if [ -z "$app_entry" ]; then
	if [ "$old_runtime" != "$app_runtime" ]; then
		check_result "$E_ARGS" "ENTRY is required when switching between Node.js and Python"
	fi
	app_entry=$(get_web_app_value 'APP_ENTRY')
fi
is_app_entry_valid "$app_entry"

# Perform verification if read-only mode is enabled
check_hestia_demo_mode

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

add_web_app_unit "$app_template" "$app_entry"
update_object_value 'web' 'DOMAIN' "$domain" '$APP_TEMPLATE' "$app_template"
update_object_value 'web' 'DOMAIN' "$domain" '$APP_ENTRY' "$app_entry"

$BIN/v-update-web-domain-app-deps "$user" "$domain" > /dev/null 2>&1
deps_result=$?

if [ "$(get_web_app_value 'APP_STATUS')" = 'running' ]; then
	if ! start_web_app; then
		echo "WARNING: Application of $domain failed to start, see $HOMEDIR/$user/web/$domain/logs/app.log"
	fi
fi

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

if [ "$deps_result" -ne 0 ]; then
	echo "WARNING: Installing dependencies failed, run v-update-web-domain-app-deps for details."
fi

# Logging
$BIN/v-log-action "$user" "Info" "Web" "Application template changed (Domain: $domain, Template: $app_template)."
log_event "$OK" "$ARGUMENTS"

exit

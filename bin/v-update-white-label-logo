#!/bin/bash
# info: update white label logo's
# options: [DOWNLOAD] [RESET]
#
# example: v-update-white-label-logo
#
# Apply custom logos when present; otherwise restore the W3VJHOST defaults.
# DOWNLOAD is retained for compatibility; defaults are always restored locally.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
reset=${2-no}

# Includes
# shellcheck source=/etc/hestiacp/hestia.conf
source /etc/hestiacp/hestia.conf
# shellcheck source=/usr/local/hestia/func/main.sh
source "$HESTIA/func/main.sh"
# load config file
source_conf "$HESTIA/conf/hestia.conf"

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

if [ "$reset" = "yes" ]; then
	rm -rf "$HESTIA/web/images/custom/"
fi

if [ -f "$HESTIA/web/images/custom/logo.svg" ]; then
	cp -f "$HESTIA/web/images/custom/logo.svg" "$HESTIA/web/images/logo.svg"
elif [ -f "$HESTIA_INSTALL_DIR/branding/logo.svg" ]; then
	cp -f "$HESTIA_INSTALL_DIR/branding/logo.svg" "$HESTIA/web/images/logo.svg"
fi

if [ -f "$HESTIA/web/images/custom/logo.png" ]; then
	cp -f "$HESTIA/web/images/custom/logo.png" "$HESTIA/web/images/logo.png"
elif [ -f "$HESTIA_INSTALL_DIR/branding/logo.png" ]; then
	cp -f "$HESTIA_INSTALL_DIR/branding/logo.png" "$HESTIA/web/images/logo.png"
fi

if [ -f "$HESTIA/web/images/custom/logo-header.svg" ]; then
	cp -f "$HESTIA/web/images/custom/logo-header.svg" "$HESTIA/web/images/logo-header.svg"
elif [ -f "$HESTIA_INSTALL_DIR/branding/logo-header.svg" ]; then
	cp -f "$HESTIA_INSTALL_DIR/branding/logo-header.svg" "$HESTIA/web/images/logo-header.svg"
fi

if [ -f "$HESTIA/web/images/custom/favicon.png" ]; then
	cp -f "$HESTIA/web/images/custom/favicon.png" "$HESTIA/web/images/favicon.png"
elif [ -f "$HESTIA_INSTALL_DIR/branding/favicon.png" ]; then
	cp -f "$HESTIA_INSTALL_DIR/branding/favicon.png" "$HESTIA/web/images/favicon.png"
fi

if [ -f "$HESTIA/web/images/custom/favicon.ico" ]; then
	cp -f "$HESTIA/web/images/custom/favicon.ico" "$HESTIA/web/favicon.ico"
elif [ -f "$HESTIA_INSTALL_DIR/branding/favicon.ico" ]; then
	cp -f "$HESTIA_INSTALL_DIR/branding/favicon.ico" "$HESTIA/web/favicon.ico"
fi

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

exit

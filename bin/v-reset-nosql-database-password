#!/bin/bash
# info: reset a user-scoped NoSQL database password
# options: USER TYPE NAME
#
# example: v-reset-nosql-database-password admin mongodb app

user=$1
type=$2
name=$3

source /etc/hestiacp/hestia.conf
source "$HESTIA/func/main.sh"
source "$HESTIA/func/nosql.sh"
source_conf "$HESTIA/conf/hestia.conf"

check_args '3' "$#" 'USER TYPE NAME'
is_format_valid 'user'
is_type_valid 'mongodb redis' "$type"
nosql_validate_name "$name"
is_object_valid 'user' 'USER' "$user"
is_object_unsuspended 'user' 'USER' "$user"
USER_DATA="$HESTIA/data/users/$user"
record_file=$(nosql_record_file "$type")
record=$(grep -F "NAME='$name' " "$record_file" 2>/dev/null)
if [ -z "$record" ]; then
	check_result "$E_NOTEXIST" "NoSQL database $name doesn't exist"
fi
parse_object_kv_list "$record"
NOSQL_NEW_PASSWORD=$(nosql_random_password)
check_hestia_demo_mode

if [ "$type" = "mongodb" ]; then
	nosql_load_service_config mongodb
	command -v mongosh >/dev/null 2>&1 || check_result "$E_DISABLED" "mongosh is not installed"
	statement="const target=client.getDB('$DATABASE'); if(target.getUser('$DBUSER')) target.updateUser('$DBUSER',{pwd:'$NOSQL_NEW_PASSWORD'}); else target.createUser({user:'$DBUSER',pwd:'$NOSQL_NEW_PASSWORD',roles:[{role:'readWrite',db:'$DATABASE'}]});"
	if ! nosql_mongodb_eval "$statement"; then
		check_result "$E_DB" "failed to reset MongoDB database password"
	fi
else
	nosql_load_service_config redis
	command -v redis-cli >/dev/null 2>&1 || check_result "$E_DISABLED" "redis-cli is not installed"
	if ! nosql_redis_set_user "$DBUSER" "${NAMESPACE}*" "$NOSQL_NEW_PASSWORD"; then
		check_result "$E_DB" "failed to reset Redis database password"
	fi
fi

$BIN/v-log-action "$user" "Info" "Databases" "Reset $type database password for $name."
log_event "$OK" "$ARGUMENTS"
printf '%s\n' "$NOSQL_NEW_PASSWORD"
exit
